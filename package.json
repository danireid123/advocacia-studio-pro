{
  "name": "advocacia-studio-pro",
  "version": "1.0.5",
  "description": "Advocacia Studio Pro - Suite Executiva de Atendimento e Processos",
  "main": "main.js",
  "author": "Escritorio Digital",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.advocaciastudiopro.app",
    "productName": "Advocacia Studio Pro",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false,
      "artifactName": "Advocacia-Studio-Pro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Advocacia Studio Pro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danireid123",
        "repo": "advocacia-studio-pro",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "qrcode": "^1.5.3",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}