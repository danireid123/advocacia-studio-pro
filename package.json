{
  "name": "advocacia-studio-pro",
  "version": "1.0.0",
  "description": "Suite Juridica Executiva com WhatsApp Integrado",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.advocacia.studiopro",
    "productName": "Advocacia Studio Pro",
    "asar": true,
    "asarUnpack": [
      "node_modules/puppeteer/**",
      "node_modules/puppeteer-core/**",
      "node_modules/whatsapp-web.js/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Advocacia Studio Pro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "seu-usuario",
        "repo": "advocacia-studio-pro"
      }
    ]
  },
  "dependencies": {
    "qrcode": "^1.5.3",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.8.9"
  }
}
